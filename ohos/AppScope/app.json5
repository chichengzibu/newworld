{
  // New World 鸿蒙 PC(HarmonyOS PC)HAP 壳工程 —— 应用级配置
  // 与 electron-builder.json5 的 appId 保持一致,便于两端共用同一套包标识。
  "app": {
    "bundleName": "com.newworld.nw",
    "vendor": "New World Team",
    // versionCode 必须为整数且单调递增:主(4).次(05).修订(00).构建(00) → 4050000
    "versionCode": 4050000,
    // versionName 只允许 A.B.C 形式,不能带 -alpha 后缀
    // (根 package.json 为 4.5.0-alpha,此处取 4.5.0,发版时由 CI 同步)
    "versionName": "4.5.0",
    "icon": "$media:app_icon",
    "label": "$string:app_name",

    // TODO(需官方 OHOS Electron runtime / DevEco 确认):
    //   官方鸿蒙 PC Electron runtime v34.6.3-20260105.1 可能要求在 app 级声明
    //   额外字段(如 targetPriority / runtime 标记 / bundleType)。
    //   在拿到官方模板前不臆造字段,保持标准 stage 模型最小集。
  }
}
