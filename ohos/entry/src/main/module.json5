{
  "module": {
    "name": "entry",
    "type": "entry",
    "description": "$string:module_desc",
    "mainElement": "EntryAbility",
    // 鸿蒙 PC:2in1 为 PC / 笔记本形态;tablet 一并声明便于调试机验证。
    "deviceTypes": [
      "2in1",
      "tablet"
    ],
    "deliveryWithInstall": true,
    "installationFree": false,
    "pages": "$profile:main_pages",
    // AbilityStage:进程级入口,Electron 主进程的挂载点(见 ets/AppAbilityStage.ets)
    "srcEntry": "./ets/AppAbilityStage.ets",

    "abilities": [
      {
        "name": "EntryAbility",
        "srcEntry": "./ets/entryability/EntryAbility.ets",
        "description": "$string:EntryAbility_desc",
        "icon": "$media:startIcon",
        "label": "$string:EntryAbility_label",
        "startWindowIcon": "$media:startIcon",
        "startWindowBackground": "$color:start_window_background",
        "exported": true,
        "skills": [
          {
            "entities": [
              "entity.system.home"
            ],
            "actions": [
              "action.system.home"
            ]
          }
        ]
        // TODO(需官方 OHOS Electron runtime 确认):
        //   官方 runtime 可能要求 Ability 使用其提供的基类 / 指定
        //   "launchType": "singleton" 之外的启动模式,或声明专用 metadata
        //   (见下方 metadata 段)。以官方模板为准。
      }
    ],

    // ---------------------------------------------------------------
    // metadata:指向 Electron 主进程入口与 app 资源目录
    // ---------------------------------------------------------------
    // TODO(需官方 OHOS Electron runtime 确认):
    //   下列 key 名(electron.main / electron.app.dir / electron.preload)
    //   是按「runtime 需要知道 main 入口与 app 根目录」推导的占位命名,
    //   官方 runtime v34.6.3-20260105.1 的真实 key 未经验证。
    //   拿到官方文档后请对齐 key 名;若 runtime 改用 rawfile 内的
    //   package.json(main 字段)定位入口,则本段可整体删除。
    //   值中的路径相对于 HAP 内的 app 资源根(见 ohos/scripts/sync-assets.mjs
    //   产出的 entry/assets/app/)。
    "metadata": [
      {
        "name": "electron.main",
        "value": "dist-electron/main.js"
      },
      {
        "name": "electron.preload",
        "value": "dist-electron/preload.js"
      },
      {
        "name": "electron.app.dir",
        "value": "app"
      },
      {
        "name": "electron.renderer.index",
        "value": "dist/index.html"
      },
      {
        "name": "electron.runtime.version",
        "value": "34.6.3-20260105.1"
      }
    ],

    // ---------------------------------------------------------------
    // 权限
    // ---------------------------------------------------------------
    "requestPermissions": [
      {
        // 访问 LLM / MCP / OpenClaw 网关(含 127.0.0.1 本地网关)
        "name": "ohos.permission.INTERNET"
      },
      {
        // 网络状态探测(离线降级、网关健康检查)
        "name": "ohos.permission.GET_NETWORK_INFO"
      },
      {
        // Agent 长任务执行期间保持后台运行
        "name": "ohos.permission.KEEP_BACKGROUND_RUNNING"
      },
      {
        // 导出对话 / 生成 docx 到下载目录(user_grant,需运行时弹窗授权)
        "name": "ohos.permission.READ_WRITE_DOWNLOAD_DIRECTORY",
        "reason": "$string:reason_download_dir",
        "usedScene": {
          "abilities": [
            "EntryAbility"
          ],
          "when": "inuse"
        }
      }
      // TODO(需官方 OHOS Electron runtime / DevEco 确认):
      //   1. 若需读写用户任意目录(BashTool / 文件类技能),需申请
      //      ohos.permission.FILE_ACCESS_MANAGER 或 READ_WRITE_DOCUMENTS_DIRECTORY,
      //      前者为 system_basic 级,普通应用申请会被驳回 —— 需确认鸿蒙 PC 上
      //      普通应用可用的文件访问方案(可能只能走 FilePicker)。
      //   2. 截图技能(D1ScreenshotQA)所需的屏幕采集权限在鸿蒙 PC 上的
      //      对应项未知,待官方确认后补充。
      //   3. 若 runtime 需要创建子进程执行命令(BashTool / execFile),
      //      鸿蒙沙箱下是否允许、需要何种权限,同样待确认
      //      (当前 sandbox L1 在 ohos 已走 stub 并明确返回失败)。
    ]
  }
}
