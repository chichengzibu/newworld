{
  // 工程级构建配置(hvigor)。DevEco Studio 打开 ohos/ 目录即识别为 Stage 模型工程。
  "app": {
    // TODO(需官方 OHOS Electron runtime / DevEco 确认):
    //   签名配置由 DevEco Studio「Project Structure → Signing Configs」自动生成,
    //   或由 AGConnect 下发 .p12 / .cer / .p7b 后手工填入。
    //   证书文件放在 ./signature/ 下(已 gitignore),生成后此数组形如:
    //   {
    //     "name": "default",
    //     "type": "HarmonyOS",
    //     "material": {
    //       "certpath": "./signature/pipiclaw-debug.cer",
    //       "storePassword": "<encrypted>",
    //       "keyAlias": "debugKey",
    //       "keyPassword": "<encrypted>",
    //       "profile": "./signature/pipiclaw-debug.p7b",
    //       "signAlg": "SHA256withECDSA",
    //       "storeFile": "./signature/pipiclaw-debug.p12"
    //     }
    //   }
    "signingConfigs": [],
    "products": [
      {
        "name": "default",
        // 已对齐本机已装 SDK: HarmonyOS 6.1.0(API 23)。原 TODO 标注的 5.0.0(12)
        // 与已装 SDK 不符导致 hvigor 报 "SDK component missing"。
        // TODO(需官方 OHOS Electron runtime 确认): v34.6.3-20260105.1 对
        // compatibleSdkVersion 有下限要求时,再据此调整。
        "compatibleSdkVersion": "6.1.0(23)",
        "runtimeOS": "HarmonyOS",
        // 待签名配置生成后取消注释:
        // "signingConfig": "default",
        "buildOption": {
          "strictMode": {
            "caseSensitiveCheck": true
          }
        }
      }
    ],
    "buildModeSet": [
      {
        "name": "debug"
      },
      {
        "name": "release"
      }
    ]
  },
  "modules": [
    {
      "name": "entry",
      "srcPath": "./entry",
      "targets": [
        {
          "name": "default",
          "applyToProducts": [
            "default"
          ]
        }
      ]
    }
  ]
}
