{
  "modelVersion": "5.0.0",
  "name": "pipiclaw-ohos",
  "version": "4.5.0",
  "description": "PiPiClaw 鸿蒙 PC(HarmonyOS PC)HAP 壳工程 —— 承载官方 OHOS Electron runtime 与既有 vite 产物",
  "main": "",
  "author": "PiPiClaw Team",
  "license": "MIT",
  "dependencies": {
    // ============================================================
    // TODO(需官方 OHOS Electron runtime 确认)—— Electron runtime 依赖占位
    // ------------------------------------------------------------
    // 目标运行时: 鸿蒙 PC 官方 Electron runtime v34.6.3-20260105.1
    // 本机未安装 HarmonyOS SDK / DevEco / 官方 runtime,包坐标(scope + 包名 +
    // 分发渠道: ohpm 公共仓 / 华为私有仓 / 本地 .har)均未经验证,故不写死,
    // 避免 `ohpm install` 因不存在的包而失败。
    //
    // 取得官方发布物后按其文档二选一取消注释:
    //
    //   // A. ohpm 远程包(若官方发布到 ohpm 仓)
    //   "@ohos/electron": "34.6.3-20260105.1",
    //
    //   // B. 本地 .har / 目录引用(若官方以离线包分发)
    //   "electron-ohos": "file:../third_party/electron-ohos-34.6.3-20260105.1.har",
    //
    // 同时需在 ohos/entry/oh-package.json5 的 dependencies 中做相同声明,
    // 并执行 `ohpm install` 重新生成 oh-package-lock.json5。
    // ============================================================
  },
  "devDependencies": {
    "@ohos/hypium": "1.0.21",
    "@ohos/hamock": "1.0.0"
  }
}
