{
  "$schema": "https://raw.githubusercontent.com/electron-userland/electron-builder/master/packages/app-builder-lib/scheme.json",
  "appId": "com.newworld.nw",
  "productName": "New World",
  "directories": {
    "output": "release",
    "buildResources": "resources"
  },
  "files": [
    "dist/**/*",
    "dist-electron/**/*"
  ],
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      }
    ],
    "artifactName": "NewWorld-${version}-Setup.${ext}",
    "icon": "resources/icon.ico"
  },
  "mac": {
    "target": [
      {
        "target": "dmg",
        "arch": ["x64", "arm64"]
      }
    ],
    "artifactName": "NewWorld-${version}-${arch}.${ext}",
    "category": "public.app-category.productivity",
    "icon": "resources/icon.icns",
    "identity": null,
    "hardenedRuntime": false,
    "gatekeeperAssess": false,
    "darkModeSupport": true
  },
  "linux": {
    "target": [
      {
        "target": "AppImage",
        "arch": ["x64"]
      },
      {
        "target": "deb",
        "arch": ["x64"]
      },
      {
        "target": "rpm",
        "arch": ["x64"]
      }
    ],
    "category": "Office",
    "icon": "resources/icon.png",
    "artifactName": "NewWorld-${version}-${arch}.${ext}",
    "synopsis": "New World (NW) - Desktop AI Automation Assistant",
    "description": "New World (NW) - 下一代桌面 AI 自动化助手,基于 Electron"
  },
  "publish": {
    "provider": "github",
    // 仓库已从 pipiclaw 改名为 newworld —— auto-updater 会按 owner/repo 拼
    // releases 下载地址，名字错了就拉不到更新（或拉到旧仓库的旧版本）。
    "repo": "newworld",
    "owner": "chichengzibu",
    "releaseType": "release",
    "channel": "latest"
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "deleteAppDataOnUninstall": false,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "New World"
  },
  "asar": true,
  "compression": "maximum",
  "extraResources": [
    {
      "from": "resources/",
      "to": "resources/",
      "filter": ["**/*"]
    }
  ]
}